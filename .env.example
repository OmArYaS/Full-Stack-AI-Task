# ----------------------------------------------------------------------------
# Copy to .env and adjust as needed. All values have local, zero-cost defaults.
# ----------------------------------------------------------------------------

# Local Ollama server (no cloud API keys required).
OLLAMA_BASE_URL=http://localhost:11434

# Swap to any pulled Ollama model without changing domain/application code:
# qwen2.5:7b-instruct-q4_k_m | gemma2 | deepseek-r1 | llama3.1 | ...
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_k_m

# Timeout (seconds) for LLM requests.
OLLAMA_TIMEOUT=60

# Reject inputs longer than this many characters (clear 422 error).
MAX_INPUT_LENGTH=50000

# Bounded schema-repair retries for malformed local-model JSON.
DEFAULT_MAX_RETRIES=2

# SQLite database file (created automatically).
DB_PATH=data/extraction_copilot.db
